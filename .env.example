# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Anthropic API key used ONLY by the server action that interprets user utterances
# (app/actions/interpret.ts). Never exposed to the browser. Leave empty to run on the
# deterministic interpreter alone.
ANTHROPIC_API_KEY=

# Required only when the key is organization-level (not created inside a workspace).
ANTHROPIC_WORKSPACE_ID=

# Model for the interpreter. Default claude-haiku-4-5 (latency); claude-sonnet-5 is the alternative.
AGENT_MODEL=

# "model" (Claude with deterministic fallback) or "deterministic". Default: model when a key is present.
AGENT_INTERPRETER=
